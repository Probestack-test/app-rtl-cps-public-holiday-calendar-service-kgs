{
  "info": {
    "name": "Public Holiday Calendar Service Postman Collection",
    "description": "Public holidays for more than a hundred countries: the holidays of a\nyear, the next upcoming holidays, long weekends that can be planned\naround them, and basic facts about each country. Used by scheduling,\npayroll and travel features that must know when a country is closed.\nBacked by the free public Nager.Date service, so the server URL is\nreal and reachable and a gateway generated from this specification\ncan be called end to end.\n\nOpenAPI version: 3.0.3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://date.nager.at/api/v3",
      "type": "string",
      "description": "Override with the base URL of the deployed Kong gateway."
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "countryCode",
      "value": "",
      "type": "string",
      "description": "Two-letter ISO 3166 country code."
    },
    {
      "key": "year",
      "value": "",
      "type": "string",
      "description": "The calendar year of the holidays."
    }
  ],
